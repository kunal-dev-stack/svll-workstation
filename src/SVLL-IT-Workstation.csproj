<Project Sdk="Microsoft.NET.Sdk">

  <!-- ================================================================
       SVLL IT Workstation v8.0 - Dual Build Configuration
       Admin Build:  dotnet publish -c AdminRelease  → BUILD_ADMIN defined
       User Build:   dotnet publish -c UserRelease   → BUILD_USER defined
       ================================================================ -->

  <PropertyGroup>
    <AssemblyName>SVLL-IT-Workstation</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>8.1.0</Version>
    <AssemblyVersion>8.1.0.0</AssemblyVersion>
    <FileVersion>8.1.0.0</FileVersion>
    <Authors>Kunal Turkar</Authors>
    <Company>Shree Vasu Logistics Limited</Company>
    <Product>SVLL IT Support Workstation</Product>
    <Description>Enterprise IT Management, Diagnostics &amp; Automation Workstation for Shree Vasu Logistics Limited.</Description>
    <Copyright>Copyright © 2026 Shree Vasu Logistics Limited</Copyright>
  </PropertyGroup>

  <!-- Admin Edition: Full feature set including Fleet Console, Admin Desk, Remote Control -->
  <PropertyGroup Condition="'$(Configuration)'=='AdminRelease'">
    <DefineConstants>BUILD_ADMIN;RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <AssemblyName>SVLL-IT-Workstation-Admin</AssemblyName>
    <Product>SVLL IT Workstation - Admin Edition</Product>
  </PropertyGroup>

  <!-- User Edition: End-user tools only. No admin consoles, no fleet management. -->
  <PropertyGroup Condition="'$(Configuration)'=='UserRelease'">
    <DefineConstants>BUILD_USER;RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <AssemblyName>SVLL-IT-Workstation-User</AssemblyName>
    <Product>SVLL IT Workstation - User Edition</Product>
  </PropertyGroup>

  <!-- Standard Release (legacy single-build, retains admin features) -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>BUILD_ADMIN;RELEASE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MainWindow.Complaints.cs" />
    <Compile Remove="AiComplaintEngine.cs" />
    <Compile Remove="ComplaintTicketService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="svll_brand_banner.png" />
    <Resource Include="svll_brand_logo.png" />
  </ItemGroup>

</Project>
